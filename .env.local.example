# ============================================
# Environment Variables - Debora Grataroli Website
# ============================================
# Copy this file to .env.local and fill in the values
# cp .env.local.example .env.local

# ============================================
# GitHub OAuth (for Decap CMS)
# ============================================
# Create OAuth App: GitHub Settings → Developer settings → OAuth Apps
# Homepage URL: https://deboragrataroli.it
# Callback URL: https://deboragrataroli.it/api/auth

GITHUB_CLIENT_ID=Ov23lie5ZAfI8YGAL9S0
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ============================================
# Site Configuration
# ============================================
NEXT_PUBLIC_SITE_URL=https://deboragrataroli.it
NEXT_PUBLIC_SITE_NAME="Debora Grataroli"

# ============================================
# CMS Configuration
# ============================================
NEXT_PUBLIC_GITHUB_REPO=davidegamba-gewiss/deboragrataroli-website
NEXT_PUBLIC_GITHUB_BRANCH=main

# ============================================
# Media Storage
# ============================================
NEXT_PUBLIC_MEDIA_FOLDER=/public/media

# ============================================
# Analytics (Optional)
# ============================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# Contact Form - Web3Forms
# ============================================
# Get your API key at https://web3forms.com/
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# SMTP Alternative (uncomment if using SMTP instead of Web3Forms)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your_smtp_password
# CONTACT_EMAIL=info@deboragrataroli.it
